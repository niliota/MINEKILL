{
  "schemaVersion": 1,
  "id": "minekill",
  "version": "${version}",
  "name": "MINEKILL",
  "description": "Minecraft as the simulation and content engine for ULTRAKILL. Minecraft owns the player, inventory, mining and combat; ULTRAKILL owns the world and camera.",
  "authors": [
    "MINEKILL"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.minekill.MinekillClient"
    ]
  },
  "mixins": [
    {
      "config": "minekill.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3"
  }
}